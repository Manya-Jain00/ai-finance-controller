# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- optional overrides ---------------------------------------------------
# Model for the reconciliation agent (Phase 3/4). Default: gemini-3.5-flash-lite
# (15 req/min on the free tier). gemini-3.5-flash is stronger but only 5 req/min
# — if you use it, also set FC_MIN_CALL_INTERVAL=13.
# FC_AGENT_MODEL=gemini-3.5-flash

# Model for the settlement Q&A layer (Phase 6). Falls back to FC_AGENT_MODEL,
# then to gemini-3.5-flash-lite.
# FC_QA_MODEL=gemini-3.5-flash

# Seconds to wait between model calls (self-throttle for the free tier).
# FC_MIN_CALL_INTERVAL=13
