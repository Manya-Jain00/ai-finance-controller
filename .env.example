# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model. Default is gemini-3.5-flash-lite (15 req/min on
# the free tier). gemini-3.5-flash is stronger but only 5 req/min — if you use
# it, also set FC_MIN_CALL_INTERVAL=13
# FC_AGENT_MODEL=gemini-3.5-flash
# FC_MIN_CALL_INTERVAL=13
